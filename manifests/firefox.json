{
  "manifest_version": 3,
  "name": "LazyChamp",
  "version": "0.4.0",
  "description": "Compare Showdown EVs with Pokémon Champions points, convert teams, and use LazyChamp in Pokémon Showdown's Team Builder.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open LazyChamp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://*.psim.us/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core.js",
        "panel.js",
        "converter.js",
        "panel.css",
        "dex-data.js"
      ],
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://*.psim.us/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lazychamp@lazytoro",
      "strict_min_version": "115.0"
    }
  }
}
